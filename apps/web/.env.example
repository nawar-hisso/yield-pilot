# apps/web — frontend env template. Copy to .env.local and fill in.
NEXT_PUBLIC_APP_NAME=YieldPilot
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_CHAIN_TICKER=ETH
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# Reown Cloud project id (https://cloud.reown.com).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Pimlico API key (https://dashboard.pimlico.io). Bundler URL is derived
# per chain: https://api.pimlico.io/v2/{chainId}/rpc?apikey={key}
NEXT_PUBLIC_PIMLICO_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws/events

# Read-only query endpoint for the canonical Sepolia subgraph — safe to
# share. Swap for your own URL if you deploy your own copy.
NEXT_PUBLIC_SUBGRAPH_URL_SEPOLIA=https://api.studio.thegraph.com/query/1748410/yield-pilot/v0.0.4
NEXT_PUBLIC_SUBGRAPH_URL_BASE_SEPOLIA=

# Contract addresses — pre-filled with the canonical Sepolia deployment
# so the dashboard works out-of-the-box. Swap if you redeploy.
NEXT_PUBLIC_VAULT_ADDRESS=0x62B63E6E3e8b265D7A4A807B50db7f9069E9Dd2B
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x2a046e7e9f0a0ce0a466F357adE6ccf171977BDc
NEXT_PUBLIC_MOCK_AAVE_ADDRESS=0xaBeC4198F517E25aa7375702eb56aF13e5478e7f
NEXT_PUBLIC_PAYMASTER_CONTRACT_ADDRESS=0xE18c286370dc85876006E57eFDEbBa2d1aa8b991
NEXT_PUBLIC_ACCOUNT_FACTORY_ADDRESS=0xe38f4049F7C18DE4fC9C48eb102134cC42027AC9
NEXT_PUBLIC_ACCOUNT_IMPL_ADDRESS=0x4B99773e756bCA1DF5ff9696014db0E25a90916B
NEXT_PUBLIC_VAULT_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_MOCK_USDC_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_ACCOUNT_FACTORY_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_ACCOUNT_IMPL_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_PAYMASTER_CONTRACT_ADDRESS_BASE_SEPOLIA=
