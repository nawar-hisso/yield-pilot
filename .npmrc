# Force a flat node_modules for apps so Next.js resolves a single copy of
# wagmi / viem / @tanstack/react-query. Without this, pnpm's peer-dep-aware
# tree gives Reown's wagmi adapter and our hooks different wagmi instances,
# which breaks React context (WagmiProviderNotFoundError at runtime).
shamefully-hoist=true
auto-install-peers=true
strict-peer-dependencies=false
