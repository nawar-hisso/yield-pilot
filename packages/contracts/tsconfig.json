{
  "extends": "@yield-pilot/tsconfig/node.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "./hardhat.config.ts",
    "./test/**/*",
    "./ignition/**/*",
    "./scripts/**/*",
    "./typechain-types/**/*",
    "./types/**/*"
  ]
}
