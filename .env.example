# YieldPilot — root .env.example
# Copy to .env.local and fill in. Never commit .env / .env.local.
# Per-app overrides live in apps/<name>/.env.example.

# === PROJECT ===
PROJECT_NAME=yield-pilot
NEXT_PUBLIC_APP_NAME=YieldPilot

# === CHAIN — primary: Sepolia; secondary: Base Sepolia ===
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_CHAIN_TICKER=ETH
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# Secondary chain for multi-chain UX
NEXT_PUBLIC_CHAIN_ID_BASE_SEPOLIA=84532
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# === DEPLOYER (server-only) ===
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# === WALLET — Reown AppKit (wallets-only; email + socials disabled) ===
# Dashboard: https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# === SMART ACCOUNT — DIY ERC-4337 passkey ===
# Bundler (free tier for testnets):
# Dashboard: https://dashboard.pimlico.io
NEXT_PUBLIC_PIMLICO_API_KEY=

# === ERC-4337 Paymaster backend (apps/api signs sponsorship approvals) ===
# Generate a fresh key (never reuse across envs): `cast wallet new`.
PAYMASTER_SIGNER_PRIVATE_KEY=

# Sliding-window daily caps (wei). Defaults keep testnet spend safe.
PAYMASTER_DAILY_GLOBAL_CAP_WEI=50000000000000000    # 0.05 ETH/day across all senders
PAYMASTER_DAILY_PER_SENDER_CAP_WEI=10000000000000000 # 0.01 ETH/day per sender

# === DATABASE (apps/api + packages/database) ===
# Local dev: docker-compose brings up postgres:16 at this URL
DATABASE_URL=postgresql://dev:dev@localhost:5432/yield-pilot
DIRECT_URL=postgresql://dev:dev@localhost:5432/yield-pilot

# === SUBGRAPH ===
# Subgraph Studio (The Graph) — https://thegraph.com/studio
# Read-only query endpoints for the canonical Sepolia deployment. Anyone
# running the app can query these. Swap for your own if you redeploy.
NEXT_PUBLIC_SUBGRAPH_URL_SEPOLIA=https://api.studio.thegraph.com/query/1748410/yield-pilot/v0.0.4
NEXT_PUBLIC_SUBGRAPH_URL_BASE_SEPOLIA=
# Only needed if you deploy your own subgraph.
STUDIO_SLUG=
STUDIO_DEPLOY_KEY=

# === APPS/API ===
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WS_PATH=/ws/events
CORS_ORIGIN=http://localhost:3000

# === APPS/WEB → APPS/API ===
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws/events

# === CONTRACT ADDRESSES — per-chain ===
# Pre-filled with the canonical Sepolia deployment so the dashboard works
# out-of-the-box. Swap for your own if you redeploy.
# Frontend (public)
NEXT_PUBLIC_VAULT_ADDRESS_SEPOLIA=0x62B63E6E3e8b265D7A4A807B50db7f9069E9Dd2B
NEXT_PUBLIC_VAULT_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_MOCK_USDC_ADDRESS_SEPOLIA=0x2a046e7e9f0a0ce0a466F357adE6ccf171977BDc
NEXT_PUBLIC_MOCK_USDC_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_MOCK_AAVE_ADDRESS_SEPOLIA=0xaBeC4198F517E25aa7375702eb56aF13e5478e7f
NEXT_PUBLIC_MOCK_AAVE_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_PAYMASTER_CONTRACT_ADDRESS_SEPOLIA=0xa77447088b961861626c79D00d62e2024E7190B2
NEXT_PUBLIC_PAYMASTER_CONTRACT_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_ACCOUNT_FACTORY_ADDRESS_SEPOLIA=0xe38f4049F7C18DE4fC9C48eb102134cC42027AC9
NEXT_PUBLIC_ACCOUNT_FACTORY_ADDRESS_BASE_SEPOLIA=
NEXT_PUBLIC_ACCOUNT_IMPL_ADDRESS=0x4B99773e756bCA1DF5ff9696014db0E25a90916B

# Backend-only copies (apps/api reads these from the server; no NEXT_PUBLIC_ prefix)
VAULT_ADDRESS_SEPOLIA=0x62B63E6E3e8b265D7A4A807B50db7f9069E9Dd2B
VAULT_ADDRESS_BASE_SEPOLIA=
VAULT_ADDRESS_LOCALHOST=
PAYMASTER_CONTRACT_ADDRESS_SEPOLIA=0xa77447088b961861626c79D00d62e2024E7190B2
PAYMASTER_CONTRACT_ADDRESS_BASE_SEPOLIA=
ACCOUNT_FACTORY_ADDRESS_SEPOLIA=0xe38f4049F7C18DE4fC9C48eb102134cC42027AC9
ACCOUNT_FACTORY_ADDRESS_BASE_SEPOLIA=

# Back-compat single-chain fallback (used by lib/contracts.ts when the per-chain
# value above is empty). Prefer the per-chain vars for clarity.
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
NEXT_PUBLIC_MOCK_AAVE_ADDRESS=
NEXT_PUBLIC_PAYMASTER_ADDRESS=
